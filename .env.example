# Copy to .env and adjust. All values have sensible defaults in medassist/config.py.

# --- LLM (Ollama) ---
OLLAMA_URL=http://localhost:11434
MEDASSIST_LLM_MODEL=llama3.1:8b
MEDASSIST_LLM_TIMEOUT=180

# --- Vision encoder (BiomedCLIP via open_clip) ---
MEDASSIST_BIOMEDCLIP_MODEL=hf-hub:microsoft/BiomedCLIP-PubMedBERT_256-vit_base_patch16_224

# --- Text embeddings (Sentence Transformers, BioBERT family) ---
MEDASSIST_EMBEDDING_MODEL=pritamdeka/BioBERT-mnli-snli-scinli-scitail-mednli-stsb

# --- Runtime ---
# auto | cuda | cpu
MEDASSIST_DEVICE=auto
# Where Hugging Face weights are cached (kept out of git)
HF_HOME=./models_cache
