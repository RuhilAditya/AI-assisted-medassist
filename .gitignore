# Python
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
*.egg-info/

# Secrets / local config
.env
.env.*
!.env.example

# Model weights & caches (downloaded on demand, never committed)
models_cache/
*.pt
*.bin
*.safetensors

# Data: only the small synthetic samples in data/samples/ are committed.
# data/processed (IU X-Ray subset) and data/store (case store) are rebuilt by scripts.
data/*
!data/samples/
data/samples/*.dcm
data/samples/biomedclip_examples/

# Run logs
logs/
*.log

# OS / IDE
.DS_Store
Thumbs.db
.vscode/
.idea/
